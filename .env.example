# --- AI-model (påkrævet for rigtige svar) ---
# Nøglerne bruges kun af backend og sendes aldrig til browseren. .env er udelukket fra Git.
AI_PROVIDER=openai                   # openai (standard) | anthropic

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium       # none | minimal | low | medium | high | xhigh | max

# Alternativ provider (bruges når AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium        # low | medium | high | xhigh | max

# --- Datakilde ---
# "demo" = lokal DuckDB med syntetiske DEMODATA (standard). "databricks" = Azure Databricks SQL Warehouse.
DATA_SOURCE=demo

# Azure Databricks (bruges når DATA_SOURCE=databricks).
# Brug en service principal / token med KUN SELECT-rettigheder på tabellerne nedenfor.
DATABRICKS_SERVER_HOSTNAME=          # fx adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_HTTP_PATH=                # fx /sql/1.0/warehouses/abcdef1234567890
DATABRICKS_TOKEN=
DATABRICKS_TABLES=                   # fx main.mealmind.meal_events,main.mealmind.pantry_items
# Valgfrit: eksisterende ML-modeller i Databricks Model Serving, som agenten må kalde.
# DATABRICKS_ML_ENDPOINTS={"waste_model": {"endpoint": "mealmind-waste-v1", "description": "Forudsiger madspild pr. vare"}}

# --- Sikkerhed og drift ---
APP_ACCESS_TOKEN=                    # sæt ved hosting: kræver "Bearer <token>" på alle API-kald
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=20
SQL_ROW_LIMIT=50000
SQL_TIMEOUT_SECONDS=20
AGENT_MAX_STEPS=12
