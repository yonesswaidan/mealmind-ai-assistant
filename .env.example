# --- AI-model (påkrævet for rigtige svar) ---
# Nøglerne bruges kun af backend og sendes aldrig til browseren. .env er udelukket fra Git.
AI_PROVIDER=openai                   # openai (standard) | anthropic

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium       # none | minimal | low | medium | high | xhigh | max

# Alternativ provider (bruges når AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium        # low | medium | high | xhigh | max

# --- Datakilde ---
# "demo"         = lokal DuckDB med syntetiske DEMODATA (standard).
# "local_export" = godkendt, pseudonymiseret MealMind-udtræk (fra biteowl/data-platform) analyseret lokalt.
# "databricks"   = Azure Databricks SQL Warehouse med MealMinds Silver/Gold-tabeller.
DATA_SOURCE=demo

# Lokalt udtræk (bruges når DATA_SOURCE=local_export): mappe med ét udtræk eller flere (nyeste bruges).
# Læg aldrig udtræk i Git.
LOCAL_EXPORT_DIR=

# Azure Databricks (bruges når DATA_SOURCE=databricks). Identiteten må KUN have SELECT (se README).
DATABRICKS_SERVER_HOSTNAME=          # fx adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_HTTP_PATH=                # fx /sql/1.0/warehouses/abcdef1234567890
# Anbefalet: OAuth M2M med en service principal (Microsoft Entra ID / Databricks).
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Alternativ: personligt/servicetoken (bruges kun hvis CLIENT_ID/SECRET ikke er sat).
DATABRICKS_TOKEN=
# Tabeller AIDA må læse. "catalog.schema.*" tager alle tabeller i skemaet (interne _-tabeller udelades).
DATABRICKS_TABLES=mealmind.silver.*,mealmind.gold.*
# Valgfrit: eksisterende ML-modeller i Databricks Model Serving, som agenten må kalde.
# DATABRICKS_ML_ENDPOINTS={"skip_model": {"endpoint": "mealmind-skip-classifier", "description": "Sandsynlighed for at et planlagt måltid springes over"}}

# --- Sikkerhed og drift ---
APP_ACCESS_TOKEN=                    # sæt ved hosting: kræver "Bearer <token>" på alle API-kald
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=20
SQL_ROW_LIMIT=50000
SQL_TIMEOUT_SECONDS=20
AGENT_MAX_STEPS=12
ML_MAX_CALLS_PER_QUESTION=4         # loft over ML-kørsler pr. spørgsmål
